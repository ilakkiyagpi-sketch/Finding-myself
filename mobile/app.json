{
  "expo": {
    "name": "Finding Myself",
    "slug": "finding-myself",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.findingmyself.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7A5C8E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.findingmyself.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7A5C8E"
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-speech-recognition",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Finding Myself \u2014 Today",
              "description": "Today\u2019s plan, check-in and journal in one tap",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "scheme": "findingmyself",
    "extra": {
      "googleWebClientId": "",
      "updateRepo": "ilakkiyagpi-sketch/Finding-myself"
    }
  }
}
